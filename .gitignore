# Byte-compiled / optimized .gitignore for Python

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Pytest cache
.pytest_cache/

# mypy / lint
.mypy_cache/
.ruff_cache/

# Environment files
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Alembic local states
alembic/versions/*.pyc
